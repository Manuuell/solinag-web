---
/** Tarjeta de producto del catálogo. Se genera desde src/data/productos.js. */
import { whatsapp } from "../data/sitio.js";
import Icono from "./Icono.astro";

const { producto: p, indice } = Astro.props;
---

<article
  id={p.ancla ?? undefined}
  class="card reveal grid items-start gap-5 lg:grid-cols-[132px_1fr_auto]"
  style={`--i:${indice}; scroll-margin-top:150px`}
>
  <div
    class="h-[168px] w-full flex-none overflow-hidden rounded-md bg-surface-2 shadow-sm
           lg:h-[132px] lg:w-[132px]"
  >
    <img
      src={p.img}
      alt={p.alt}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500
             group-hover:scale-108"
    />
  </div>

  <div>
    <h3 class="text-[19px]">{p.titulo}</h3>
    <p class="mt-2 text-[14.5px] text-ink-soft">{p.resumen}</p>

    <div class="mt-3.5 flex flex-wrap gap-2.5">
      {p.etiquetas.map((e) => (
        <span
          class="inline-flex items-center gap-2 rounded-full bg-surface-2 px-3.5 py-[9px]
                 text-[13.5px] font-semibold text-ink-soft"
        >
          {e}
        </span>
      ))}
    </div>

    <button
      class="mt-3.5 inline-flex items-center gap-1.5 rounded-sm px-1 py-2 text-[13px]
             font-bold text-blue-600 [&_svg]:h-4 [&_svg]:w-4
             [&_svg]:transition-transform hover:[&_svg]:translate-x-1"
      data-abrir-ficha={p.clave}
    >
      {p.textoBoton}
      <Icono nombre="flecha" />
    </button>
  </div>

  <div class="flex flex-row items-center justify-between gap-2.5 lg:flex-col lg:items-stretch">
    <a
      class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-[18px]
             py-2.5 text-[13.5px] font-bold whitespace-nowrap text-white shadow-blue
             transition-[transform,background-color] duration-200 ease-spring
             hover:-translate-y-0.5 hover:bg-blue-700"
      href={whatsapp(p.mensaje)}
      target="_blank"
      rel="noopener"
    >
      Cotizar
    </a>
  </div>
</article>
