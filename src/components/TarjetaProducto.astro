---
/**
 * Tarjeta de producto del catálogo.
 *
 * La imagen ocupa la mitad superior y manda: el texto es un pie corto. Antes
 * la foto era una miniatura de 132 px al lado del texto.
 */
import { whatsapp } from "../data/sitio.js";
import Icono from "./Icono.astro";

const { producto: p, indice } = Astro.props;

// Los renders de catálogo vienen recortados sobre blanco: si se recortan otra
// vez para llenar el marco, se les corta media máquina. La foto real sí llena.
const contener = p.encuadre === "contener";

// Las dos primeras cifras bastan como gancho; el resto vive en la ficha.
const destacadas = p.stats.slice(0, 2);

// Con más de una foto, la tarjeta las rota al pasar el cursor (ver sitio.js).
// `img` no siempre es la primera de la galería (es la variante más
// representativa, no la primera cargada), así que se busca su posición para
// que la tarjeta arranque mostrando esa misma foto y no otra distinta.
const rotarGaleria = (p.galeria?.length ?? 0) > 1;
const indiceInicial = rotarGaleria ? Math.max(p.galeria.findIndex((g) => g.src === p.img), 0) : 0;
---

<article
  id={p.ancla ?? undefined}
  class="card reveal group flex flex-col !p-0"
  style={`--i:${indice}; scroll-margin-top:150px`}
>
  <div
    class:list={[
      "relative aspect-4/3 overflow-hidden",
      !p.img ? "bg-linear-140 from-blue-700 to-blue-900" : contener ? "bg-white p-6" : "bg-surface-2",
    ]}
  >
    {rotarGaleria ? (
      // Las fotos van todas montadas, apiladas por opacidad: sitio.js alterna
      // cuál se ve mientras el cursor está encima. Sin JS o sin hover (mobile)
      // queda fija la de indiceInicial, que es exactamente el mismo resultado
      // que antes de este cambio.
      <div class="absolute inset-0" data-galeria-tarjeta aria-hidden="true">
        {p.galeria.map((g, i) => (
          <img
            src={g.src}
            alt={g.alt}
            loading="lazy"
            data-galeria-img
            class:list={[
              "absolute inset-0 h-full w-full transition-[opacity,transform] duration-700",
              "ease-out-soft group-hover:scale-105",
              contener ? "object-contain" : "object-cover",
              i === indiceInicial ? "opacity-100" : "opacity-0",
            ]}
          />
        ))}
      </div>
    ) : p.img ? (
      <img
        src={p.img}
        alt={p.alt}
        loading="lazy"
        class:list={[
          "h-full w-full transition-transform duration-700 ease-out-soft group-hover:scale-105",
          contener ? "object-contain" : "object-cover",
        ]}
      />
    ) : (
      <div class="grid h-full w-full place-items-center text-white/85" aria-hidden="true">
        <Icono nombre={p.icono ?? "edificio"} class="h-20 w-20" />
      </div>
    )}

    <span
      class="absolute top-4 left-4 rounded-full bg-white/90 px-3 py-1.5 text-[11px]
             font-bold tracking-[0.08em] text-blue-700 uppercase backdrop-blur-sm"
    >
      {p.tag}
    </span>

    {p.galeria?.length > 1 && (
      <span
        class="absolute right-4 bottom-4 rounded-full bg-ink/70 px-2.5 py-1 text-[11px]
               font-bold text-white backdrop-blur-sm"
      >
        {p.galeria.length} imágenes
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-7">
    <h3 class="text-[21px]">{p.titulo}</h3>
    <p class="mt-2 text-[14.5px] text-ink-soft">{p.resumen}</p>

    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 border-t border-line pt-5">
      {destacadas.map((s) => (
        <div>
          <b class="block text-[17px] leading-tight text-ink">{s.v}</b>
          <span class="text-[12px] text-muted">{s.u}</span>
        </div>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3 pt-1">
      <button
        class="inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-[18px] py-2.5
               text-[13.5px] font-bold whitespace-nowrap text-white shadow-blue
               transition-[transform,background-color] duration-200 ease-spring
               hover:-translate-y-0.5 hover:bg-blue-700
               [&_svg]:h-4 [&_svg]:w-4 [&_svg]:transition-transform
               hover:[&_svg]:translate-x-1"
        data-abrir-ficha={p.clave}
      >
        Ficha técnica
        <Icono nombre="flecha" />
      </button>

      <a
        class="inline-flex items-center gap-1.5 text-[13.5px] font-bold text-ink-soft
               transition-colors hover:text-green-800 [&_svg]:h-4 [&_svg]:w-4"
        href={whatsapp(p.mensaje)}
        target="_blank"
        rel="noopener"
      >
        <Icono nombre="whatsapp" />
        Cotizar
      </a>
    </div>
  </div>
</article>
