---
/** Franja azul superior con textos que rotan. El JS alterna la clase .show. */
import { FRANJA } from "../data/sitio.js";
---

<div
  class="bg-linear-90 from-blue-700 via-blue-600 to-blue-700 text-white"
  aria-hidden="true"
>
  <div class="mx-auto w-full max-w-[1200px] flex justify-center px-3.5 py-[7px]">
    <div class="widget-stack h-5 w-[min(360px,90vw)]" data-rotador>
      {FRANJA.map((texto) => (
        <span class="w-item justify-center text-center text-[12.5px] font-semibold tracking-[0.02em]">
          {texto}
        </span>
      ))}
    </div>
  </div>
</div>
