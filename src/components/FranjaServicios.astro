---
/** Franja azul superior con textos que rotan. El JS alterna la clase .show. */
import { FRANJA } from "../data/sitio.js";
---

<div class="border-b border-line text-white/45" aria-hidden="true">
  <div class="mx-auto flex w-full max-w-[1400px] justify-center px-6 py-2.5 md:px-10">
    <div class="widget-stack h-5 w-[min(360px,90vw)]" data-rotador>
      {FRANJA.map((texto) => (
        <span class="w-item justify-center text-center text-[12px] font-medium tracking-[0.14em] uppercase">
          {texto}
        </span>
      ))}
    </div>
  </div>
</div>
