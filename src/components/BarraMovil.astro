---
/** Barra de navegación inferior, estilo app. Solo visible en móvil (≤720px). */
import { NAV } from "../data/sitio.js";
import Icono from "./Icono.astro";

const { actual } = Astro.props;

const ICONOS = {
  inicio: "casa",
  soluciones: "caja",
  proyectos: "proceso",
  nosotros: "persona",
  contacto: "telefono",
};
---

<nav
  class="glass fixed inset-x-3 bottom-[calc(12px+env(safe-area-inset-bottom,0px))] z-140
         flex items-center justify-around rounded-xl px-1.5 py-2 shadow-lg md:hidden"
  aria-label="Navegación inferior"
>
  {NAV.map((item) => (
    <a
      href={item.href}
      aria-current={actual === item.id ? "page" : undefined}
      class:list={[
        "flex flex-col items-center gap-1 rounded-md px-2 py-1.5 text-[11px] font-semibold",
        "transition-[color,background-color,transform] duration-200 ease-spring",
        "[&_svg]:h-[21px] [&_svg]:w-[21px]",
        actual === item.id
          ? "-translate-y-0.5 bg-green-500/15 text-green-800"
          : "text-ink-soft",
      ]}
    >
      <Icono nombre={ICONOS[item.id]} />
      {item.texto}
    </a>
  ))}
</nav>
