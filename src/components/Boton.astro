---
/**
 * Botón del sistema de diseño. Renderiza <a> si recibe href, si no <button>.
 * Reemplaza a las clases .btn / .btn-primary / .btn-dark… del CSS original.
 */
const {
  variante = "primary",
  tamano = "md",
  bloque = false,
  href,
  class: clase = "",
  ...resto
} = Astro.props;

const BASE =
  "inline-flex items-center justify-center gap-2 rounded-full font-bold whitespace-nowrap " +
  "transition-[transform,box-shadow,background-color,color] duration-200 ease-spring active:scale-[0.96] " +
  "[&_svg]:w-[18px] [&_svg]:h-[18px] [&_svg]:flex-none";

const VARIANTES = {
  primary: "bg-green-500 text-blue-900 shadow-green hover:-translate-y-0.5 hover:scale-[1.015]",
  dark: "bg-blue-600 text-white shadow-blue hover:-translate-y-0.5 hover:scale-[1.015] hover:bg-blue-700",
  // ghost y outline-light: los 5 usos del sitio caen sobre fondo claro (BannerCta
  // ×3, 404, diálogo de ficha técnica) — ninguno queda sobre una banda oscura,
  // así que las dos variantes se definen para fondo claro. Si algún día hace
  // falta un botón secundario dentro de una banda oscura, se agrega aparte.
  ghost:
    "bg-ink/4 text-ink border border-line hover:bg-ink/8 hover:border-ink/20",
  "outline-light":
    "bg-transparent text-ink border border-ink/20 hover:bg-ink/5 hover:border-ink/35",
  whatsapp:
    "bg-whatsapp text-whatsapp-ink shadow-[0_16px_34px_-14px_rgb(37_211_102/0.55)] hover:-translate-y-0.5 hover:scale-[1.015]",
};

const TAMANOS = {
  md: "px-[26px] py-[15px] text-[15px]",
  sm: "px-[18px] py-2.5 text-[13.5px]",
};

const clases = [BASE, VARIANTES[variante], TAMANOS[tamano], bloque && "w-full", clase]
  .filter(Boolean)
  .join(" ");

const Etiqueta = href ? "a" : "button";
---

<Etiqueta class={clases} href={href} {...resto}><slot /></Etiqueta>
