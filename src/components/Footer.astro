---
/**
 * Pie de página. Barra compacta de una fila — marca, contacto, redes —
 * calcada de la maqueta que Manuel señaló (2026-08-25), en vez del footer
 * de cuatro columnas que había antes.
 *
 * Se decidió a propósito quitar las columnas "Navegación" y "Soluciones":
 * eran enlaces reales a páginas y categorías, y Manuel confirmó que quería
 * el resultado compacto de la referencia aunque eso significara perderlos.
 *
 * Lo que SÍ se conserva pese a no estar en la referencia: la línea de
 * copyright. Es texto legal (marca y año), no un enlace de navegación — la
 * decisión de quitar columnas no alcanza a esto. Desde 2026-08-26 lleva la
 * marca ("SOLINAG SAS") y no la razón social completa: Manuel pidió
 * acortarla. La razón social sigue publicada en los datos estructurados que
 * lee Google (ver Base.astro).
 */
import { CORREO_VISIBLE, EMPRESA, SOCIAL, TELEFONO_VISIBLE } from "../data/sitio.js";
import Icono from "./Icono.astro";
import logoFooter from "../assets/logo-footer.svg?raw";
import { escoparClasesSvg } from "../utils/svg.js";

// Del mismo paquete de marca que banner-solinag.svg (la franja superior):
// comparte sus nombres de clase cls-N y sin escopar le pisaba el font-size.
// Ver utils/svg.js.
const logoFooterEscopado = escoparClasesSvg(logoFooter, "logo-footer");

const CONTACTO = [
  { icono: "ubicacion", texto: EMPRESA.direccion.completa },
  { icono: "telefono", texto: TELEFONO_VISIBLE },
  { icono: "correo", texto: CORREO_VISIBLE },
  { icono: "web", texto: EMPRESA.url.replace(/^https?:\/\//, "") },
];

const CONTENEDOR = "mx-auto w-full max-w-[1200px] px-6";
const TITULO_COL =
  "mb-[10px] text-[12px] uppercase tracking-[0.08em] text-white/50 font-extrabold";
---

<footer class="relative overflow-hidden bg-blue-900 pt-6 text-white/82">
  <!-- Halos de color del fondo -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(600px 260px at 12% 0%, rgb(137 243 54 / 0.16), transparent 60%),
      radial-gradient(500px 260px at 88% 0%, rgb(90 130 220 / 0.25), transparent 60%);"
    aria-hidden="true"
  >
  </div>

  <div class={`${CONTENEDOR} relative`}>
    <div
      class="flex flex-col gap-9 md:flex-row md:items-center md:gap-0
             md:divide-x md:divide-white/12"
    >
      {/* Marca. `logo-footer.svg` es el lockup horizontal blanco+verde que
          mandó Manuel (2026-08-26), copiado tal cual: ni un color ni una
          coordenada tocados. Ya es la versión de fondo oscuro — el blanco da
          15.87:1 sobre el azul del footer y el verde 8.16:1.

          Se muestra entero, sin recortar el `viewBox` ni con overflow. Se
          intentaron las dos cosas y ambas mutilan el logotipo: los <text> van
          dentro de un <g> con `transform`, así que su bbox está en
          coordenadas locales y no sirve para recortar; y el recorte por CSS
          dejaba 8 de sus 18 elementos fuera del contenedor. Vale más el
          margen sobrante que un logotipo cortado.

          Va incrustado y no como <img> porque lleva <text> con Montserrat:
          como imagen se renderiza aislado, sin las fuentes de la página. */}
      <div class="md:flex-[1.1] md:pr-8 [&_svg]:block [&_svg]:h-auto [&_svg]:w-[300px] [&_svg]:max-w-full">
        <Fragment set:html={logoFooterEscopado} />
      </div>

      <div class="md:flex-[1.3] md:px-8">
        <h4 class={TITULO_COL}>Contacto</h4>
        <ul class="flex flex-col gap-2">
          {CONTACTO.map((c) => (
            <li class="flex items-start gap-2.5 text-[14.5px] leading-[1.3]">
              <Icono nombre={c.icono} class="mt-px h-[17px] w-[17px] flex-none text-green-500" />
              <span>{c.texto}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:flex-none md:pl-8">
        <h4 class={TITULO_COL}>Síguenos en</h4>
        <div class="flex gap-2.5">
          {SOCIAL.map((red) => (
            <a
              href={red.href}
              target="_blank"
              rel="noopener"
              aria-label={red.nombre}
              class="flex h-[38px] w-[38px] items-center justify-center rounded-full border
                     border-white/12 bg-white/8 transition-[background-color,transform,color]
                     duration-200 ease-spring hover:-translate-y-[3px] hover:bg-green-500
                     hover:text-blue-900 [&_svg]:h-[17px] [&_svg]:w-[17px]"
            >
              <Icono nombre={red.id} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div
      class="relative mt-6 flex flex-wrap items-center justify-between gap-x-5 gap-y-3
             border-t border-white/12 pt-4 text-[13px] text-white/50"
    >
      <span>© {new Date().getFullYear()} {EMPRESA.marca}. Todos los derechos reservados.</span>
      <span>{EMPRESA.direccion.corta}</span>

      {/* Créditos de desarrollo. `sentralabs.png` es la variante del logo
          pensada para fondo oscuro (texto blanco, fondo transparente) — ya
          no hace falta la placa blanca que pedía la versión anterior de
          fondo sólido. */}
      <a
        href="https://sentralabs.co"
        target="_blank"
        rel="noopener"
        aria-label="Sitio desarrollado por Sentra Labs — abre sentralabs.co"
        class="ml-auto flex items-center gap-2 text-white/50 transition-colors hover:text-white/85"
      >
        Desarrollado por
        <img
          src="/assets/img/sentralabs.png"
          alt="Sentra Labs"
          width="1458"
          height="513"
          class="h-[30px] w-auto"
        />
      </a>
    </div>
  </div>

  {/* Reserva el alto del botón flotante de WhatsApp (22px de separación +
      52px de botón) con el propio fondo del pie. El pie es siempre lo
      último de cada página (ver Base.astro): al reservar aquí y no en el
      body, el hueco queda pintado de azul oscuro en vez de dejar asomar el
      gris claro del fondo de página debajo.

      Esta reserva ES el espacio inferior del pie: por eso el <footer> lleva
      `pt-6` y ningún `pb`. Antes llevaba `py-10`, así que los 76px se
      sumaban a 40px de relleno y dejaban 116px de azul vacío bajo el
      copyright (2026-08-26: Manuel pidió acortar el pie). Si algún día se
      le devuelve un `pb`, descontarlo de aquí. */}
  <div class="h-[calc(76px_+_env(safe-area-inset-bottom,0px))]" aria-hidden="true"></div>
</footer>
