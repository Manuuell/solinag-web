---
/** Banner degradado de llamada a la acción, al pie de varias páginas. */
const { titulo, texto } = Astro.props;
---

<div
  class="reveal relative flex flex-wrap items-center justify-between gap-8 overflow-hidden
         rounded-md border border-line bg-surface px-7 py-12 md:px-14 md:py-16"
>
  {/* Una sola veta verde a la izquierda, en vez de un degradado en todo el bloque. */}
  <span class="absolute inset-y-0 left-0 w-1 bg-green-500" aria-hidden="true"></span>

  <div class="relative">
    <h3 class="max-w-[22ch] text-[clamp(24px,3.4vw,40px)] leading-[1.05] text-white">{titulo}</h3>
    {texto && <p class="mt-4 max-w-[46ch] text-white/55">{texto}</p>}
  </div>

  <div class="relative flex flex-wrap gap-3"><slot /></div>
</div>
