---
/**
 * Tarjeta compacta de producto para el vistazo del inicio.
 * Igual que la del catálogo, pero sin cifras ni acciones: solo imagen,
 * categoría y título, y enlaza a su ancla en Soluciones.
 */
const { producto: p, href, indice = 0 } = Astro.props;
const contener = p.encuadre === "contener";
---

<a
  href={href}
  class="card reveal group block !p-0 focus-visible:outline-offset-4"
  style={`--i:${indice}`}
>
  <div
    class:list={[
      "relative aspect-4/3 overflow-hidden",
      contener ? "bg-white p-5" : "bg-surface-2",
    ]}
  >
    <img
      src={p.img}
      alt={p.alt}
      loading="lazy"
      class:list={[
        "h-full w-full transition-transform duration-700 ease-out-soft group-hover:scale-105",
        contener ? "object-contain" : "object-cover",
      ]}
    />
  </div>
  <div class="p-6">
    <span class="text-[11px] font-bold tracking-[0.08em] text-green-500 uppercase">{p.tag}</span>
    <h3 class="mt-1.5 text-[17px]">{p.titulo}</h3>
    <p class="mt-2 text-[13.5px] text-ink-soft">{p.resumen}</p>
  </div>
</a>
