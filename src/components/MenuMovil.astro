---
/** Menú desplegable en móvil. El JS alterna la clase .open en el contenedor. */
import { NAV, enlaceContacto, whatsapp } from "../data/sitio.js";
import Marca from "./Marca.astro";
import Icono from "./Icono.astro";
import Boton from "./Boton.astro";

const { actual } = Astro.props;
---

<div
  id="menu-movil"
  class="fixed inset-0 z-200 bg-ink/55 backdrop-blur-[6px] opacity-0 pointer-events-none
         transition-opacity duration-[450ms] [&.open]:opacity-100 [&.open]:pointer-events-auto"
  aria-hidden="true"
  data-menu-movil
>
  <div
    class="absolute inset-x-3 top-3 rounded-lg border border-line bg-surface p-5 shadow-lg opacity-0
           -translate-y-4 scale-[0.97] transition-[transform,opacity] duration-[450ms] ease-spring
           [.open_&]:translate-y-0 [.open_&]:scale-100 [.open_&]:opacity-100"
  >
    <div class="flex items-center justify-between mb-2">
      <Marca alturaLogo={30} mostrarSas={false} />
      <button
        class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-2
               text-white [&_svg]:h-[19px] [&_svg]:w-[19px]"
        aria-label="Cerrar menú"
        data-cerrar-menu
      >
        <Icono nombre="cerrar" />
      </button>
    </div>

    <nav class="mt-2.5 flex flex-col gap-1" aria-label="Navegación móvil">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={actual === item.id ? "page" : undefined}
          class:list={[
            "flex items-center justify-between rounded-md px-3.5 py-[15px] text-[17px] font-bold",
            actual === item.id ? "bg-green-500/15 text-green-500" : "text-white/75",
          ]}
        >
          {item.texto}
          <Icono nombre="chevron" class="h-4 w-4 opacity-40" />
        </a>
      ))}
    </nav>

    <div class="mt-3.5 flex gap-2.5">
      <Boton href={enlaceContacto(actual)} variante="primary" bloque>Cotizar</Boton>
      <Boton
        href={whatsapp()}
        variante="whatsapp"
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp"
      >
        <Icono nombre="whatsapp" class="!h-5 !w-5" />
      </Boton>
    </div>
  </div>
</div>
