---
/**
 * Cabecera fija. Antes estaba copiada íntegra en las 4 páginas; ahora recibe
 * `actual` para saber qué enlace resaltar.
 */
import { NAV, ruta, whatsapp } from "../data/sitio.js";
import Marca from "./Marca.astro";
import Icono from "./Icono.astro";
import Boton from "./Boton.astro";

const { actual } = Astro.props;

const ENLACE = "px-4 py-2.5 rounded-full font-semibold text-[14.5px] transition-colors duration-200";
const ICONO_BTN =
  "inline-flex items-center justify-center w-10 h-10 rounded-full bg-surface-2 text-blue-600 " +
  "transition-[transform,background-color] duration-200 ease-spring " +
  "hover:-translate-y-0.5 hover:scale-105 hover:bg-green-100 [&_svg]:w-[19px] [&_svg]:h-[19px]";
---

<header
  class="sticky top-0 z-100 py-3.5 transition-[padding] duration-200"
  data-header
>
  <div class="mx-auto w-full max-w-[1200px] px-6">
    <div
      class="flex items-center justify-between gap-4 rounded-full border border-white/60
             bg-white/72 py-2.5 pl-4 pr-3.5 shadow-sm backdrop-blur-[20px] backdrop-saturate-[180%]
             transition-[box-shadow,background-color] duration-200"
      data-barra
    >
      <Marca />

      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        {NAV.map((item) => (
          <a
            href={item.href}
            aria-current={actual === item.id ? "page" : undefined}
            class:list={[
              ENLACE,
              actual === item.id
                ? "bg-blue-600 text-white"
                : "text-ink-soft hover:bg-surface-2 hover:text-ink",
            ]}
          >
            {item.texto}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener"
          aria-label="Síguenos en Instagram"
          class={`hidden sm:inline-flex ${ICONO_BTN}`}
        >
          <Icono nombre="instagram" />
        </a>
        <a
          href={whatsapp()}
          target="_blank"
          rel="noopener"
          aria-label="Escríbenos por WhatsApp"
          class={`hidden sm:inline-flex ${ICONO_BTN}`}
        >
          <Icono nombre="whatsapp" />
        </a>

        <Boton href={ruta("nosotros", "contacto")} variante="primary" tamano="sm">Cotizar</Boton>

        <button
          class={`lg:hidden ${ICONO_BTN}`}
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="menu-movil"
          data-abrir-menu
        >
          <Icono nombre="menu" />
        </button>
      </div>
    </div>
  </div>
</header>
