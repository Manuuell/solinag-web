---
/**
 * Cabecera. Plana y transparente: sin píldora de cristal ni sombra.
 *
 * Sobre fondo oscuro el glassmorphism no aporta profundidad, solo suciedad.
 * La jerarquía la marcan el peso tipográfico y el espacio.
 */
import { NAV, SOCIAL, enlaceContacto, whatsapp } from "../data/sitio.js";
import Marca from "./Marca.astro";
import Icono from "./Icono.astro";

const { actual } = Astro.props;
---

<header
  class="sticky top-0 z-100 border-b border-transparent bg-paper/80 backdrop-blur-md
         transition-[border-color,background-color] duration-300"
  data-header
>
  <div class="mx-auto flex w-full max-w-[1400px] items-center justify-between gap-8 px-6 py-5 md:px-10">
    <Marca />

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Navegación principal">
      {NAV.slice(0, 4).map((item) => (
        <a
          href={item.href}
          aria-current={actual === item.id ? "page" : undefined}
          class:list={[
            "relative text-[15px] font-medium transition-colors duration-200",
            "after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-green-500",
            "after:transition-all after:duration-300",
            actual === item.id
              ? "text-white after:w-full"
              : "text-white/60 after:w-0 hover:text-white hover:after:w-full",
          ]}
        >
          {item.texto}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-5">
      <a
        href={SOCIAL.find((r) => r.id === "instagram").href}
        target="_blank"
        rel="noopener"
        aria-label="Síguenos en Instagram"
        class="hidden text-white/50 transition-colors hover:text-white sm:block [&_svg]:h-5 [&_svg]:w-5"
      >
        <Icono nombre="instagram" />
      </a>

      <a
        href={enlaceContacto(actual)}
        class="hidden text-[15px] font-semibold text-green-500 underline decoration-green-500/40
               underline-offset-[6px] transition-colors hover:decoration-green-500 sm:block"
      >
        Cotizar
      </a>

      <button
        class="text-white lg:hidden [&_svg]:h-6 [&_svg]:w-6"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-abrir-menu
      >
        <Icono nombre="menu" />
      </button>
    </div>
  </div>
</header>
