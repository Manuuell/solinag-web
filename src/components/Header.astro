---
/**
 * Cabecera. Cristal claro traslúcido sobre el fondo de la página, igual que
 * el sitio original — .glass ya estaba definido en global.css sin usarse.
 */
import { NAV, SOCIAL, enlaceContacto, whatsapp } from "../data/sitio.js";
import Marca from "./Marca.astro";
import Icono from "./Icono.astro";
import Boton from "./Boton.astro";

const { actual } = Astro.props;
---

<header
  class="glass sticky top-0 z-100 border-b border-transparent
         transition-[border-color,background-color] duration-300"
  data-header
>
  <div class="mx-auto flex w-full max-w-[1400px] items-center justify-between gap-8 px-6 py-5 md:px-10">
    <Marca />

    {/* Los cinco elementos del menú, "Contacto" incluido. Ese último apunta a
        un ancla dentro de Nosotros, así que se resuelve con enlaceContacto():
        estando ya en esa página devuelve solo "#contacto" y el navegador se
        desplaza en vez de recargar la página entera. */}
    <nav class="hidden items-center gap-7 lg:flex xl:gap-9" aria-label="Navegación principal">
      {NAV.map((item) => (
        <a
          href={item.id === "contacto" ? enlaceContacto(actual) : item.href}
          aria-current={actual === item.id ? "page" : undefined}
          class:list={[
            "relative text-[15px] font-medium transition-colors duration-200",
            "after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-green-500",
            "after:transition-all after:duration-300",
            actual === item.id
              ? "text-ink after:w-full"
              : "text-ink-soft after:w-0 hover:text-ink hover:after:w-full",
          ]}
        >
          {item.texto}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-5">
      <a
        href={SOCIAL.find((r) => r.id === "instagram").href}
        target="_blank"
        rel="noopener"
        aria-label="Síguenos en Instagram"
        class="hidden text-muted transition-colors hover:text-ink sm:block [&_svg]:h-5 [&_svg]:w-5"
      >
        <Icono nombre="instagram" />
      </a>

      {/* Verde sólido con texto navy, no blanco. El blanco sobre green-500
          da 1.41:1 y es ilegible; el navy de la variante `primary` da
          11.29:1 y se ve igual de contundente.

          El `hidden` va en este envoltorio y no en el propio botón: <Boton>
          ya trae `inline-flex` en sus clases base, y como las dos utilidades
          tienen la misma especificidad gana la que Tailwind emita más tarde
          — no la que se escriba después en el atributo. En móvil sobra,
          porque Cotizar ya está dentro del menú desplegable. */}
      <span class="hidden sm:block">
        <Boton href={enlaceContacto(actual)} variante="primary" tamano="sm">
          Cotizar
        </Boton>
      </span>

      <button
        class="text-ink lg:hidden [&_svg]:h-6 [&_svg]:w-6"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-abrir-menu
      >
        <Icono nombre="menu" />
      </button>
    </div>
  </div>
</header>
