---
/**
 * Iconos SVG del sitio.
 *
 * En el sitio original cada icono estaba pegado a mano en cada página: ~142
 * bloques <svg> repetidos entre los cuatro archivos. Aquí cada uno se define
 * una vez y se usa como <Icono nombre="whatsapp" />.
 */

const { nombre, class: clase, ...resto } = Astro.props;

// Los de contorno heredan el color del texto; los sólidos se rellenan con él.
const TRAZO = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
};
const SOLIDO = { fill: "currentColor" };

const ICONOS = {
  // Interfaz
  menu: [TRAZO, '<path d="M4 7h16M4 12h16M4 17h16"/>'],
  cerrar: [TRAZO, '<path d="M6 6l12 12M18 6L6 18"/>'],
  chevron: [{ ...TRAZO, "stroke-linecap": "butt" }, '<path d="M9 6l6 6-6 6"/>'],
  flecha: [{ ...TRAZO, "stroke-width": "2.4" }, '<path d="M5 12h14M13 6l6 6-6 6"/>'],
  check: [{ ...TRAZO, "stroke-width": "3" }, '<path d="M4 12l6 6L20 6"/>'],

  // Contacto
  ubicacion: [TRAZO, '<path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 1 1 18 0Z"/><circle cx="12" cy="10" r="3"/>'],
  telefono: [TRAZO, '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.99.36 1.96.67 2.9a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.18-1.24a2 2 0 0 1 2.11-.45c.94.31 1.91.54 2.9.67A2 2 0 0 1 22 16.92Z"/>'],
  correo: [TRAZO, '<path d="M4 4h16v16H4V4Z"/><path d="m22 6-10 7L2 6"/>'],

  // Barra inferior móvil
  casa: [TRAZO, '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>'],
  caja: [TRAZO, '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h.01M15 9h.01M9 15h6"/>'],
  proceso: [TRAZO, '<path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 12l4-2M3 12l3 3"/><path d="M12 7v5l3 2"/>'],
  persona: [TRAZO, '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/>'],

  // Ejes y categorías
  agro: [TRAZO, '<path d="M12 22c4-2 7-6 7-11a7 7 0 1 0-14 0c0 5 3 9 7 11Z"/><path d="M12 12v6"/>'],
  engranaje: [TRAZO, '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/>'],
  edificio: [TRAZO, '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>'],
  bici: [TRAZO, '<circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><path d="M9 18h4l3-9h3M9 18l3-9"/>'],
  diana: [TRAZO, '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".6" fill="currentColor"/>'],

  // Franja "por qué SOLINAG"
  llave: [TRAZO, '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94Z"/>'],
  fabrica: [TRAZO, '<path d="M2 20h20M4 20V10l4-4 4 4v10M12 20v-6l4-4 4 4v6"/>'],
  bombilla: [TRAZO, '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.5.4.8 1 .8 1.7V17h6.4v-.6c0-.7.3-1.3.8-1.7A7 7 0 0 0 12 2Z"/>'],
  hoja: [TRAZO, '<path d="M12 21s-7-4.35-9.5-9C.5 7.5 3 3 7 3c2 0 3.5 1 5 3 1.5-2 3-3 5-3 4 0 6.5 4.5 4.5 9-2.5 4.65-9.5 9-9.5 9Z"/>'],

  // Chips del hero
  grafico: [{ ...TRAZO, "stroke-width": "2.2" }, '<path d="M12 20V10M18 20V4M6 20v-6"/>'],
  reloj: [{ ...TRAZO, "stroke-width": "2.2" }, '<path d="M4 12a8 8 0 1 0 16 0 8 8 0 1 0-16 0Z"/><path d="M12 8v4l3 2"/>'],
  mas: [{ ...TRAZO, "stroke-width": "2.2" }, '<path d="M12 3v18M3 12h18"/>'],
  punto: [SOLIDO, '<circle cx="12" cy="12" r="10"/>'],

  // Redes
  whatsapp: [SOLIDO, '<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.02c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.88-1.24-4.76-4.13-4.9-4.32-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.09 1-2.38.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.14-.28.29-.12.57.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.24 2.22 1.38.28.14.44.12.61-.07.16-.19.68-.79.86-1.06.19-.28.37-.23.61-.14.24.09 1.55.73 1.82.86.26.14.44.2.5.31.07.12.07.65-.17 1.32z"/>'],
  instagram: [{ ...TRAZO, "stroke-linecap": "butt", "stroke-linejoin": "miter" }, '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/>'],
  facebook: [SOLIDO, '<path d="M13 22v-9h3l.5-3.5H13V7.2c0-1 .4-1.7 1.9-1.7H16.5V2.2C16 2.1 14.8 2 13.5 2 10.7 2 9 3.7 9 6.8V9.5H6V13h3v9h4Z"/>'],
  linkedin: [SOLIDO, '<path d="M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 8.98h4V21H3V8.98ZM9 8.98h3.8v1.64h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.7c0-1.36-.02-3.1-1.9-3.1-1.9 0-2.19 1.48-2.19 3v5.8H9V8.98Z"/>'],
  youtube: [SOLIDO, '<path d="M22 12s0-3.2-.4-4.7c-.24-.87-.94-1.55-1.82-1.79C18.2 5 12 5 12 5s-6.2 0-7.78.5A2.4 2.4 0 0 0 2.4 7.3C2 8.8 2 12 2 12s0 3.2.4 4.7c.24.87.94 1.53 1.82 1.77C5.8 19 12 19 12 19s6.2 0 7.78-.5c.88-.24 1.58-.9 1.82-1.77.4-1.5.4-4.73.4-4.73Zm-11.98 3.2V8.8L15.6 12l-5.58 3.2Z"/>'],
};

if (!ICONOS[nombre]) {
  throw new Error(
    `Icono desconocido: "${nombre}". Disponibles: ${Object.keys(ICONOS).join(", ")}`
  );
}

const [attrs, contenido] = ICONOS[nombre];
---

<svg viewBox="0 0 24 24" aria-hidden="true" class={clase} {...attrs} {...resto} set:html={contenido} />
