---
import Base from "../layouts/Base.astro";
import Contenedor from "../components/Contenedor.astro";
import Seccion from "../components/Seccion.astro";
import Boton from "../components/Boton.astro";
import { ruta } from "../data/sitio.js";
---

<Base
  titulo="Página no encontrada · SOLINAG SAS"
  descripcion="La página que buscas no existe o cambió de dirección."
  noindex
>
  <Seccion>
    <Contenedor class="py-20 text-center">
      <span class="eyebrow">Error 404</span>
      <h1 class="mt-2.5 text-[clamp(34px,5vw,52px)]">Esta página no existe</h1>
      <p class="mx-auto mt-3.5 max-w-[52ch] text-[clamp(16px,1.6vw,18px)] text-ink-soft">
        Puede que el enlace esté mal escrito o que la página haya cambiado de dirección.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3.5">
        <Boton href={ruta("inicio")} variante="primary">Volver al inicio</Boton>
        <Boton href={ruta("soluciones")} variante="ghost">Ver soluciones</Boton>
      </div>
    </Contenedor>
  </Seccion>
</Base>
