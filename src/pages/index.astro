---
import Base from "../layouts/Base.astro";
import Contenedor from "../components/Contenedor.astro";
import Seccion from "../components/Seccion.astro";
import CabeceraSeccion from "../components/CabeceraSeccion.astro";
import BannerCta from "../components/BannerCta.astro";
import Boton from "../components/Boton.astro";
import Icono from "../components/Icono.astro";
import BandaCredibilidad from "../components/BandaCredibilidad.astro";
import TarjetaVistazo from "../components/TarjetaVistazo.astro";
import { EMPRESA, ruta } from "../data/sitio.js";
import { PRODUCTOS } from "../data/productos.js";
import { escoparClasesSvg } from "../utils/svg.js";
import logoSelloRaw from "../assets/logo-footer.svg?raw";

// El sello de "¿Por qué nosotros?" reutiliza logo-footer.svg -- mismo
// archivo del pie de página, ya en blanco+verde para fondo oscuro -- pero
// solo con el ícono + "SOLINAG SAS", sin el eslogan de abajo.
//
// Recortar el viewBox NO alcanza: el eslogan cae dentro del mismo rectángulo
// que el ícono (medido con getBBox(), el ícono por sí solo ya ocupa esa
// altura; el eslogan queda geométricamente adentro, no debajo). Por eso se
// quitan del propio marcado las dos líneas de texto y la raya divisoria
// -- únicos usos de cls-1, cls-3 y cls-9 en este archivo -- y LUEGO se
// recorta el viewBox a lo que queda: la unión de ícono (x:103-498) y
// wordmark+SAS (x:592-1740), y:119-523.
//
// Prefijo de escopado distinto al de Footer.astro ("sello" vs
// "logo-footer"): es el mismo archivo incrustado dos veces en la página, y
// cada incrustación necesita sus propias clases (ver utils/svg.js).
const SELLO_VIEWBOX = "103 119 1637 404";
const logoSelloSinEslogan = logoSelloRaw
  .replace(/<text class="cls-1"[\s\S]*?<\/text>/, "")
  .replace(/<text class="cls-3"[\s\S]*?<\/text>/, "")
  .replace(/<line class="cls-9"[^>]*\/>/, "");
const logoSello = escoparClasesSvg(logoSelloSinEslogan, "sello").replace(
  /viewBox="[^"]*"/,
  `viewBox="${SELLO_VIEWBOX}"`
);

// El vistazo del inicio sale del catálogo: cuatro productos con foto real,
// en vez de las tarjetas de icono genérico que había antes.
const VISTAZO_PRODUCTOS = ["molino", "compactadora-vertical", "linea-pet", "bicitriciclo"]
  .map((c) => PRODUCTOS.find((p) => p.clave === c))
  .filter(Boolean);

// Fotografía real de la planta, para la franja de fabricación.
const PLANTA = [
  { src: "/assets/img/planta-compactadora.jpg", alt: "Compactadora vertical SOLINAG en fabricación", pie: "Compactadora vertical en planta" },
  { src: "/assets/img/planta-tablero.jpg", alt: "Tablero de control de una compactadora SOLINAG", pie: "Tablero de control propio" },
  { src: "/assets/img/planta-compactadora-frontal.jpg", alt: "Vista frontal de una compactadora SOLINAG terminada", pie: "Equipo terminado, listo para entrega" },
];

// Los tres ejes. El `color` es la clase del icono, no un degradado: el verde
// va con green-700 y no con green-500 porque estos iconos se dibujan sobre
// blanco, donde el verde de marca se vuelve ilegible (1.4:1).
const EJES = [
  {
    icono: "hojas",
    color: "text-green-700",
    titulo: "Agro",
    texto: "Soluciones para procesos y operaciones agroindustriales, pensadas para aumentar la productividad en campo y planta.",
  },
  {
    icono: "engranaje",
    color: "text-blue-600",
    titulo: "Industria",
    texto: "Maquinaria, equipos y estructuras industriales diseñadas y fabricadas para exigencias reales de operación.",
  },
  {
    icono: "reciclaje",
    color: "text-green-700",
    titulo: "Sostenibilidad",
    texto: "Tecnología para reciclaje, aprovechamiento de recursos y economía circular con impacto ambiental positivo.",
  },
];

// "¿Por qué nosotros?": reemplaza al bloque de pilares que se quitó de aquí
// (ver commit e0e98f0) por repetir, palabra por palabra, "Lo que nos define"
// en Nosotros. Estos dos puntos no se dicen en ningún otro lado del sitio —
// a propósito, para no volver a duplicar contenido.
const DIFERENCIADORES = [
  {
    icono: "proceso",
    titulo: "Un solo equipo, de punta a punta",
    texto: "Diseñamos, fabricamos, instalamos y damos mantenimiento con personal propio, sin subcontratar a terceros en el camino.",
  },
  {
    icono: "fabrica",
    titulo: "Fabricantes, no revendedores",
    texto: "Cada equipo sale de nuestra planta en Turbaco. No importamos ni revendemos catálogo genérico de otros fabricantes.",
  },
];

const CHIPS_HERO = [
  { icono: "grafico", texto: "Ingeniería a medida" },
  { icono: "reloj", texto: "200–400 kg/h de capacidad" },
  { icono: "mas", texto: "Modelado 3D y detalle" },
];
---

<Base
  titulo="SOLINAG SAS · Innovación que transforma"
  descripcion="Ingeniería, diseño y fabricación de maquinaria, estructuras industriales y soluciones de movilidad y reciclaje para el agro, la industria y la sostenibilidad."
  ogDescripcion="Ingeniería, fabricación e innovación para el agro, la industria y la sostenibilidad."
  actual="inicio"
  datosEstructurados
>
  {/* Hero oscuro a propósito (excepción puntual, como permite el manual de
      marca). El fondo es un video que arranca en el taller y termina
      resolviéndose en el logotipo; el velo que va encima es lo que sostiene
      el contraste del texto blanco sobre cualquier fotograma, así que no se
      puede quitar aunque el video se vea oscuro.

      NO lleva `loop` a propósito: como cierra sobre el logo, volver de golpe
      al taller cada 8 segundos se ve como un corte. Reproduce una vez y se
      queda congelado en el logotipo — el JS impide que se reinicie al volver
      a entrar en pantalla.

      Si el video falta o el navegador no lo puede reproducir queda el
      `poster`, que es su primer fotograma, y la portada funciona igual. */}
  <section
    class="sobre-oscuro relative isolate flex min-h-[90svh] items-center overflow-hidden
           bg-blue-900 px-6 py-20 md:px-10 md:py-24 lg:min-h-dvh"
  >
    {/* `object-right` no es decorativo: el logotipo del cierre llega casi al
        borde derecho del video, y con el encuadre centrado por defecto
        `object-cover` se comía el final de "SOSTENIBILIDAD". Anclado a la
        derecha, el recorte se lo lleva el lado izquierdo, que va bajo la
        parte densa del velo y no aporta nada que se pueda perder.

        En móvil se ancla al centro porque ahí no hay video (ver el `media`
        del <source>): lo que se encuadra es el póster. */}
    <video
      class="absolute inset-0 z-0 h-full w-full object-cover object-center md:object-right"
      autoplay
      muted
      playsinline
      preload="metadata"
      poster="/assets/img/hero-poster.jpg"
      aria-hidden="true"
      data-hero-video
    >
      {/* El `media` deja el video FUERA del móvil, y es deliberado por dos
          razones. La de forma: el clip es 3:2 y en un hero vertical
          `object-cover` lo amplía tanto que del cierre de marca solo se ven
          trozos de letra ("LINAG SAS", "…SFORMA") pisando el texto — se lee
          como un fallo. La de coste: son 2,5 MB que nadie pidió, y buena
          parte de estas visitas llegan por datos móviles desde Instagram.

          Sin `source` que case, el <video> se queda en su `poster`, que es el
          primer fotograma. Si algún día se genera una versión 9:16, se añade
          aquí como otro <source> con su propio `media` y el móvil la usa. */}
      <source src="/assets/video/hero.mp4" type="video/mp4" media="(min-width: 768px)" />
    </video>

    <div class="hero-veil absolute inset-0 z-1" aria-hidden="true"></div>

    {/* Luces ambientales, encima del velo y detrás del logotipo y del texto.
        Están apagadas mientras el clip corre y se encienden solas al acabar
        —el CSS las cuelga de .hero-cierre-visible—, que es cuando el fondo se
        queda en azul plano y la portada se veía muerta. Ver .hero-aura en
        global.css, donde están las cuentas de contraste. */}
    <div class="hero-aura absolute inset-0 z-1" aria-hidden="true"></div>

    {/* Cierre de marca, solo al terminar el clip.

        El logotipo con el que cierra el video ocupa 395x385 px del propio
        archivo (medido sobre el último fotograma), así que a pantalla completa
        se amplía entre 2,4x y 4,7x según el monitor y llega blando. Encima, el
        velo le resta un 28% de opacidad. Esta capa arregla las dos cosas: es
        el arte original a 1806 px —la versión blanco+verde, que es la que el
        manual manda usar sobre fondo oscuro— y va POR ENCIMA del velo, así que
        se ve a opacidad plena.

        Comparte `z-2` con el contenido y va antes que él en el DOM: si alguna
        vez se cruzaran, el texto pinta por encima.

        El corte en 1280px está medido, no elegido a ojo: midiendo la tinta
        real del titular (no su caja, que es el contenedor de 48rem), a 1024px
        el texto llega 139px MÁS a la derecha de donde arrancaría el logotipo,
        y a 768px lo pisa por 114px. A 1280px ya sobran 66px de aire y a partir
        de ahí solo crece. Por debajo se deja el cierre del propio video, que
        es el comportamiento de siempre. */}
    {/* El relevo va sobre un lienzo del MISMO tamaño que el fotograma del
        video (1078x720, aquí a 3x), con el logotipo compuesto exactamente en
        las coordenadas que ocupa dentro del clip: x 57,9%-94,4%, y 23,3%-76,7%,
        medidas sobre el último fotograma.

        Por eso lleva `object-cover object-right`, las mismas clases que el
        video: así el encuadre lo calcula el navegador con la misma regla, y
        las dos capas coinciden en cualquier proporción de ventana. La versión
        anterior colocaba el PNG con porcentajes del ancho y encajaba en
        ventanas apaisadas, pero se desviaba hasta 168px en una ventana alta,
        donde el video se recorta a lo ancho y su logotipo crece.

        Prioridad de carga baja en vez de carga diferida: son 346 KB que no
        deben competir con el video, pero la imagen SÍ está en el viewport y se
        sabe que va a mostrarse, así que diferirla sería arriesgado — si no ha
        cargado cuando el clip termina, el relevo se ve vacío. Con prioridad
        baja se descarga igual, solo que sin estorbar al resto. */}
    <img
      src="/assets/img/hero-cierre.png"
      alt=""
      width="3234"
      height="2160"
      fetchpriority="low"
      decoding="async"
      class="hero-cierre pointer-events-none absolute inset-0 z-2 hidden h-full w-full
             object-cover object-right min-[1280px]:block"
      aria-hidden="true"
    />

    <div class="relative z-2 mx-auto w-full max-w-[1400px]">
      <div class="reveal-stagger max-w-[48rem]">
        {/* Sin logotipo aquí a propósito: el video ya cierra sobre él, y la
            cabecera lo lleva arriba. Repetirlo una tercera vez lo abarata. */}

        {/* La caja alta se hace con `uppercase`, no escribiendo el texto en
            mayúsculas: así el contenido real sigue siendo "Innovación que
            transforma" para Google y para los lectores de pantalla, que
            deletrean letra a letra lo que encuentran escrito en versales. */}
        <h1
          class="reveal text-[clamp(36px,6.6vw,86px)] leading-[0.98] tracking-[-0.02em]
                 text-white uppercase"
          style="--i:2"
        >
          Innovación <br /><span class="text-green-500">que transforma</span>
        </h1>

        <p
          class="reveal mt-8 max-w-[40ch] text-[clamp(16px,1.5vw,19px)] leading-relaxed
                 text-white/70"
          style="--i:3"
        >
          Soluciones de ingeniería para el agro, la industria y la sostenibilidad.
        </p>

        {/* Los dos botones del hero se escriben aquí y no con <Boton> porque
            aquel es una píldora pensada para fondo claro; estos son
            rectangulares y viven sobre la banda oscura. El secundario va con
            borde en vez de subrayado, como el resto de la marca. */}
        <div class="reveal mt-11 flex flex-wrap items-center gap-4" style="--i:4">
          <a
            href={ruta("soluciones")}
            class="brillo group inline-flex items-center gap-3 bg-green-500 px-8 py-4 text-[14px]
                   font-bold tracking-[0.06em] text-blue-900 uppercase transition-colors
                   duration-200 hover:bg-green-400 [&_svg]:h-4 [&_svg]:w-4
                   [&_svg]:transition-transform hover:[&_svg]:translate-x-1"
          >
            Ver soluciones
            <Icono nombre="flecha" />
          </a>
          <a
            href={ruta("nosotros", "contacto")}
            class="inline-flex items-center border border-white/35 px-8 py-4 text-[14px]
                   font-bold tracking-[0.06em] text-white uppercase transition-colors
                   duration-200 hover:border-white hover:bg-white/10"
          >
            Cotizar
          </a>
        </div>
      </div>
    </div>
  </section>

  <BandaCredibilidad />

  <Seccion>
    <Contenedor>
      {/* "¿Qué hacemos?" es el titular de la sección, no un antetítulo: como
          eyebrow salía a 12 px y se perdía. Por eso este bloque no usa
          <CabeceraSeccion>, que impone la jerarquía antetítulo + título. */}
      <div class="reveal mb-14 text-center">
        <h2 class="text-[clamp(30px,4.4vw,50px)] tracking-[-0.01em] uppercase">
          ¿Qué <span class="text-green-700">hacemos?</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[58ch] text-[clamp(16px,1.6vw,18px)] text-ink-soft">
          Diseñamos y fabricamos soluciones de ingeniería para resolver necesidades reales
          de nuestros clientes, integrando diseño, fabricación y tecnología.
        </p>
      </div>

      {/* Columnas separadas por línea, sin tarjetas: así lo pide el material
          de marca de la empresa. El separador se dibuja con `divide-x`, que
          solo entra a partir de md — apilado no tendría sentido. */}
      <div class="reveal-stagger grid gap-12 md:grid-cols-3 md:gap-0 md:divide-x md:divide-line">
        {EJES.map((e, i) => (
          <div class="reveal px-6 text-center" style={`--i:${i}`}>
            <div
              class:list={[
                "mx-auto mb-6 grid h-24 w-24 place-items-center rounded-full bg-surface",
                "border border-line shadow-[0_10px_30px_-18px_rgb(15_31_77/0.5)]",
                "transition-transform duration-500 ease-spring hover:scale-105",
                "[&_svg]:h-11 [&_svg]:w-11",
                e.color,
              ]}
            >
              <Icono nombre={e.icono} />
            </div>
            <h3 class="mb-2.5 text-[17px] font-extrabold tracking-[0.08em] uppercase">
              {e.titulo}
            </h3>
            <p class="mx-auto max-w-[34ch] text-[14.5px] text-ink-soft">{e.texto}</p>
          </div>
        ))}
      </div>
    </Contenedor>
  </Seccion>

  {/* "¿Por qué nosotros?" reemplaza el bloque de pilares duplicado que
      vivía aquí. Estructura distinta a propósito -- un sello con el año de
      fundación más una lista de dos puntos con ícono a la izquierda -- para
      no repetir el patrón de columnas con ícono arriba que ya usan los EJES
      justo encima. */}
  <Seccion>
    <Contenedor>
      <div class="reveal rounded-lg border border-line bg-surface px-6 py-14 md:px-10 md:py-16">
        <CabeceraSeccion
          centrada
          antetitulo="¿Por qué nosotros?"
          titulo="Ingeniería y fabricación propias, sin intermediarios"
        />

        <div class="reveal-stagger grid items-center gap-10 lg:grid-cols-[auto_1fr]">
          {/* El sello. Fondo oscuro y borde verde a propósito: es el único
              elemento oscuro de una sección clara, así que concentra la
              atención en el dato que de verdad diferencia -- los años de
              trayectoria -- en vez de competir con los dos puntos de al
              lado. */}
          <div
            class="reveal mx-auto flex h-44 w-44 flex-none flex-col items-center justify-center
                   rounded-full border-4 border-green-500 bg-blue-900 text-center text-white shadow-blue"
            style="--i:0"
          >
            {/* El logotipo real (ícono + "SOLINAG SAS") arriba, como firma del
                sello: ya viene en blanco+verde, así que no hace falta ningún
                color de más para que se vea bien sobre el azul oscuro. */}
            <span class="mb-2 block w-[132px] [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={logoSello} />
            <span class="text-[11px] font-bold tracking-[0.14em] text-white/60 uppercase">Desde</span>
            <span class="text-[38px] leading-none font-extrabold">{EMPRESA.fundacion}</span>
          </div>

          <div class="grid gap-7 sm:grid-cols-2">
            {DIFERENCIADORES.map((d, i) => (
              <div class="reveal flex items-start gap-4" style={`--i:${i + 1}`}>
                <span
                  class="grid h-11 w-11 flex-none place-items-center rounded-sm border border-line
                         bg-blue-100 text-blue-600 [&_svg]:h-5 [&_svg]:w-5"
                >
                  <Icono nombre={d.icono} />
                </span>
                <div>
                  <h3 class="text-[16px] font-extrabold">{d.titulo}</h3>
                  <p class="mt-1 text-[14px] text-ink-soft">{d.texto}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Contenedor>
  </Seccion>

  <Seccion>
    <Contenedor>
      <div class="reveal mb-11 flex flex-wrap items-end justify-between gap-5">
        <div>
          <span class="eyebrow">Soluciones</span>
          <h2 class="mt-2.5 text-[clamp(28px,4vw,44px)]">Ingeniería para cada necesidad</h2>
        </div>
        <a
          href={ruta("soluciones")}
          class="group inline-flex items-center gap-1.5 font-bold text-blue-600
                 [&_svg]:h-4 [&_svg]:w-4 [&_svg]:transition-transform
                 hover:[&_svg]:translate-x-1"
        >
          Ver todas las soluciones
          <Icono nombre="flecha" />
        </a>
      </div>

      <div class="reveal-stagger grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {VISTAZO_PRODUCTOS.map((p, i) => (
          <TarjetaVistazo producto={p} href={ruta("soluciones", p.ancla ?? undefined)} indice={i} />
        ))}
      </div>
    </Contenedor>
  </Seccion>

  {/* Fabricación propia: fotografía real de la planta, no renders. */}
  <Seccion compacta>
    <Contenedor>
      <CabeceraSeccion
        antetitulo="Fabricación propia"
        titulo="Lo que sale de nuestra planta"
        entradilla="No revendemos equipos: los diseñamos y los fabricamos en Turbaco. Estas son máquinas reales, con su tablero de control y sus protecciones de seguridad."
      />
      {/* El redondeo va en el marco de la imagen y no en el <figure>: puesto
          arriba, la curva de la esquina recorta la primera letra del pie. */}
      <div class="reveal-stagger grid gap-5 md:grid-cols-3">
        {PLANTA.map((f, i) => (
          <figure class="reveal group" style={`--i:${i}`}>
            <div class="aspect-3/4 overflow-hidden rounded-lg bg-surface-2">
              <img
                src={f.src}
                alt={f.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700
                       ease-out-soft group-hover:scale-105"
              />
            </div>
            <figcaption class="mt-3 text-[13.5px] font-semibold text-ink-soft">{f.pie}</figcaption>
          </figure>
        ))}
      </div>
    </Contenedor>
  </Seccion>

  <Seccion compacta>
    <Contenedor>
      <BannerCta
        titulo="¿Tienes un proyecto de ingeniería en mente?"
        texto="Cuéntanos qué necesitas y trabajemos juntos en la solución. Respondemos rápido por WhatsApp."
      >
        <Boton href={ruta("nosotros", "contacto")} variante="primary">Cotizar ahora</Boton>
        <Boton
          href="https://wa.me/c/573197754909"
          variante="outline-light"
          target="_blank"
          rel="noopener">Ver catálogo</Boton
        >
        <Boton href={ruta("proyectos")} variante="ghost">Ver proyectos</Boton>
      </BannerCta>
    </Contenedor>
  </Seccion>
</Base>
