---
import Base from "../layouts/Base.astro";
import Contenedor from "../components/Contenedor.astro";
import Seccion from "../components/Seccion.astro";
import CabeceraSeccion from "../components/CabeceraSeccion.astro";
import TarjetaPilar from "../components/TarjetaPilar.astro";
import BannerCta from "../components/BannerCta.astro";
import Boton from "../components/Boton.astro";
import Icono from "../components/Icono.astro";
import BandaCredibilidad from "../components/BandaCredibilidad.astro";
import TarjetaVistazo from "../components/TarjetaVistazo.astro";
import { ruta } from "../data/sitio.js";
import { PRODUCTOS } from "../data/productos.js";

// El vistazo del inicio sale del catálogo: cuatro productos con foto real,
// en vez de las tarjetas de icono genérico que había antes.
const VISTAZO_PRODUCTOS = ["molino", "compactadora-vertical", "linea-pet", "bicitriciclo"]
  .map((c) => PRODUCTOS.find((p) => p.clave === c))
  .filter(Boolean);

// Fotografía real de la planta, para la franja de fabricación.
const PLANTA = [
  { src: "/assets/img/planta-compactadora.jpg", alt: "Compactadora vertical SOLINAG en fabricación", pie: "Compactadora vertical en planta" },
  { src: "/assets/img/planta-tablero.jpg", alt: "Tablero de control de una compactadora SOLINAG", pie: "Tablero de control propio" },
  { src: "/assets/img/planta-compactadora-frontal.jpg", alt: "Vista frontal de una compactadora SOLINAG terminada", pie: "Equipo terminado, listo para entrega" },
];

const EJES = [
  {
    icono: "agro",
    tono: "green",
    titulo: "Agro",
    texto: "Soluciones para procesos y operaciones agroindustriales, pensadas para aumentar la productividad en campo y planta.",
  },
  {
    icono: "engranaje",
    tono: "blue",
    titulo: "Industria",
    texto: "Maquinaria, equipos y estructuras industriales diseñadas y fabricadas para exigencias reales de operación.",
  },
  {
    icono: "proceso",
    tono: "navy",
    titulo: "Sostenibilidad",
    texto: "Tecnología para reciclaje, aprovechamiento de recursos y economía circular con impacto ambiental positivo.",
  },
];

const PORQUE = [
  { icono: "llave", titulo: "Ingeniería", texto: "Diseñamos soluciones a medida para tu necesidad." },
  { icono: "fabrica", titulo: "Fabricación", texto: "Transformamos el diseño en equipos reales." },
  { icono: "bombilla", titulo: "Innovación", texto: "Aplicamos tecnología y mejoramos procesos." },
  { icono: "hoja", titulo: "Sostenibilidad", texto: "Comprometidos con el medio ambiente." },
];

const INSIGNIAS = [
  { valor: "Agro", texto: "Soluciones agroindustriales" },
  { valor: "Industria", texto: "Maquinaria y estructuras" },
  { valor: "Sostenibilidad", texto: "Economía circular" },
];

const CHIPS_HERO = [
  { icono: "grafico", texto: "Ingeniería a medida" },
  { icono: "reloj", texto: "200–400 kg/h de capacidad" },
  { icono: "mas", texto: "Modelado 3D y detalle" },
];
---

<Base
  titulo="SOLINAG SAS · Innovación que transforma"
  descripcion="SOLINAG SAS diseña y fabrica soluciones de ingeniería para el agro, la industria y la sostenibilidad: maquinaria, estructuras industriales, movilidad y reciclaje, e ingeniería a medida."
  ogDescripcion="Ingeniería, fabricación e innovación para el agro, la industria y la sostenibilidad."
  actual="inicio"
  datosEstructurados
>
  {/* Hero oscuro a propósito (excepción puntual, como permite el manual de
      marca) — plano, sin degradado de malla ni cristal: sobre fondo oscuro
      esos efectos ensucian en vez de dar profundidad. La jerarquía la llevan
      el tamaño del titular y el aire alrededor. El resto de la página es
      clara, así que este fondo va explícito y no heredado del body. */}
  <section class="sobre-oscuro relative bg-blue-900 px-6 pt-20 pb-24 md:px-10 md:pt-28 md:pb-32">
    <div class="mx-auto grid w-full max-w-[1400px] items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
      <div>
        <span
          class="inline-flex items-center gap-2.5 text-[12px] font-semibold tracking-[0.16em]
                 text-green-500 uppercase"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
          Agro · Industria · Sostenibilidad
        </span>

        <h1
          class="mt-7 text-[clamp(44px,7.5vw,96px)] leading-[0.95] tracking-[-0.03em] text-white"
        >
          Innovación<br /><span class="text-green-500">que transforma</span>
        </h1>

        <p class="mt-8 max-w-[46ch] text-[clamp(16px,1.5vw,19px)] leading-relaxed text-white/60">
          Diseñamos y fabricamos soluciones de ingeniería a la medida de nuestros clientes,
          integrando diseño, fabricación y tecnología para el agro, la industria y la
          sostenibilidad.
        </p>

        <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={ruta("soluciones")}
            class="group inline-flex items-center gap-3 bg-green-500 px-8 py-4 text-[15px]
                   font-bold text-blue-900 transition-colors duration-200 hover:bg-green-400
                   [&_svg]:h-4 [&_svg]:w-4 [&_svg]:transition-transform
                   hover:[&_svg]:translate-x-1"
          >
            Ver soluciones
            <Icono nombre="flecha" />
          </a>
          <a
            href={ruta("nosotros", "contacto")}
            class="text-[15px] font-semibold text-white/70 underline decoration-white/25
                   underline-offset-[6px] transition-colors hover:text-white
                   hover:decoration-white"
          >
            Cotizar ahora
          </a>
        </div>

        <dl class="mt-16 grid max-w-lg grid-cols-3 gap-8 border-t border-white/12 pt-8">
          {INSIGNIAS.map((i) => (
            <div>
              <dt class="text-[17px] font-bold text-white">{i.valor}</dt>
              <dd class="mt-1 text-[12.5px] leading-snug text-white/45">{i.texto}</dd>
            </div>
          ))}
        </dl>
      </div>

      {/* Mosaico de equipo real, sin marcos ni insignias flotantes. */}
      <div class="grid grid-cols-2 gap-3" data-hero-visual>
        <figure class="col-span-2 overflow-hidden bg-surface-2">
          <img
            src="/assets/img/planta-compactadora.jpg"
            alt="Compactadora hidráulica vertical SOLINAG fabricada en la planta de Turbaco"
            width="540"
            height="720"
            class="aspect-16/10 w-full object-cover"
          />
        </figure>
        <figure class="overflow-hidden bg-white p-5">
          <img
            src="/assets/img/prod-mtc-15.jpg"
            alt="Molino triturador industrial SOL-MTC-15"
            width="233"
            height="250"
            class="aspect-4/3 w-full object-contain"
          />
        </figure>
        <figure class="overflow-hidden bg-white p-5">
          <img
            src="/assets/img/prod-bt-me01l.jpg"
            alt="Bicitriciclo de carga eléctrico SOL-BT"
            width="272"
            height="226"
            class="aspect-4/3 w-full object-contain"
          />
        </figure>
      </div>
    </div>
  </section>

  <BandaCredibilidad />

  <Seccion>
    <Contenedor>
      <CabeceraSeccion
        centrada
        antetitulo="¿Qué hacemos?"
        titulo="Tres ejes, una misma transformación"
        entradilla="Resolvemos necesidades reales de nuestros clientes integrando diseño, fabricación y tecnología, con un enfoque responsable con el medio ambiente."
      />
      <div class="reveal-stagger grid gap-6 lg:grid-cols-3">
        {EJES.map((e, i) => (
          <TarjetaPilar icono={e.icono} tono={e.tono} titulo={e.titulo} indice={i}>
            {e.texto}
          </TarjetaPilar>
        ))}
      </div>
    </Contenedor>
  </Seccion>

  <Seccion compacta>
    <Contenedor>
      <div class="reveal relative overflow-hidden rounded-xl bg-blue-900 px-7 py-16 md:px-10">
        <div
          class="pointer-events-none absolute inset-0"
          style="background: radial-gradient(500px 260px at 90% 100%, rgb(137 243 54 / 0.14), transparent 60%);"
          aria-hidden="true"
        >
        </div>

        <div class="sobre-oscuro relative mb-11 text-center">
          <span class="eyebrow">¿Por qué SOLINAG?</span>
          <h2 class="mt-2.5 text-[clamp(28px,4vw,44px)] text-white">
            Un equipo de ingeniería a tu lado
          </h2>
        </div>

        <div class="relative grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
          {PORQUE.map((p) => (
            <div class="group p-2.5 text-center">
              <div
                class="mx-auto mb-4.5 grid h-15 w-15 place-items-center rounded-full border
                       border-white/16 bg-white/8 text-green-500 transition-[transform,background-color,color]
                       duration-500 ease-spring group-hover:-translate-y-1 group-hover:scale-108
                       group-hover:bg-green-500 group-hover:text-blue-900
                       [&_svg]:h-[26px] [&_svg]:w-[26px]"
              >
                <Icono nombre={p.icono} />
              </div>
              <h4 class="mb-2 text-[16.5px] text-white">{p.titulo}</h4>
              <p class="text-[13.5px] text-white/60">{p.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </Contenedor>
  </Seccion>

  <Seccion>
    <Contenedor>
      <div class="reveal mb-11 flex flex-wrap items-end justify-between gap-5">
        <div>
          <span class="eyebrow">Soluciones</span>
          <h2 class="mt-2.5 text-[clamp(28px,4vw,44px)]">Ingeniería para cada necesidad</h2>
        </div>
        <a
          href={ruta("soluciones")}
          class="group inline-flex items-center gap-1.5 font-bold text-blue-600
                 [&_svg]:h-4 [&_svg]:w-4 [&_svg]:transition-transform
                 hover:[&_svg]:translate-x-1"
        >
          Ver todas las soluciones
          <Icono nombre="flecha" />
        </a>
      </div>

      <div class="reveal-stagger grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {VISTAZO_PRODUCTOS.map((p, i) => (
          <TarjetaVistazo producto={p} href={ruta("soluciones", p.ancla ?? undefined)} indice={i} />
        ))}
      </div>
    </Contenedor>
  </Seccion>

  {/* Fabricación propia: fotografía real de la planta, no renders. */}
  <Seccion compacta>
    <Contenedor>
      <CabeceraSeccion
        antetitulo="Fabricación propia"
        titulo="Lo que sale de nuestra planta"
        entradilla="No revendemos equipos: los diseñamos y los fabricamos en Turbaco. Estas son máquinas reales, con su tablero de control y sus protecciones de seguridad."
      />
      {/* El redondeo va en el marco de la imagen y no en el <figure>: puesto
          arriba, la curva de la esquina recorta la primera letra del pie. */}
      <div class="reveal-stagger grid gap-5 md:grid-cols-3">
        {PLANTA.map((f, i) => (
          <figure class="reveal group" style={`--i:${i}`}>
            <div class="aspect-3/4 overflow-hidden rounded-lg bg-surface-2">
              <img
                src={f.src}
                alt={f.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700
                       ease-out-soft group-hover:scale-105"
              />
            </div>
            <figcaption class="mt-3 text-[13.5px] font-semibold text-ink-soft">{f.pie}</figcaption>
          </figure>
        ))}
      </div>
    </Contenedor>
  </Seccion>

  <Seccion compacta>
    <Contenedor>
      <BannerCta
        titulo="¿Tienes un proyecto de ingeniería en mente?"
        texto="Cuéntanos qué necesitas y trabajemos juntos en la solución. Respondemos rápido por WhatsApp."
      >
        <Boton href={ruta("nosotros", "contacto")} variante="primary">Cotizar ahora</Boton>
        <Boton
          href="https://wa.me/c/573197754909"
          variante="outline-light"
          target="_blank"
          rel="noopener">Ver catálogo</Boton
        >
      </BannerCta>
    </Contenedor>
  </Seccion>
</Base>
