# Dependencias y artefactos de build
node_modules/
dist/
.astro/

# Restos del truco .nosync de iCloud (no volver a usarlo: rompe la
# resolución de módulos de Vite)
node_modules.nosync/
node_modules*/

# Utilidades de imágenes
scripts/_*.png
scripts/_extracted/

# Sistema
.DS_Store
Thumbs.db

# Herramientas de Claude Code instaladas localmente (plugins, skills de
# terceros): son config de cada máquina, no parte del proyecto. Un `git add`
# amplio los coló una vez ya (4.8 MB, 175 archivos ajenos a SOLINAG) — no
# deben volver a versionarse. .claude/launch.json sí se versiona aparte.
/.claude/skills/

# Carpeta pre-Astro, reemplazada por public/assets/ en la migración a Astro.
# Si reaparece (p. ej. un merge desde una rama vieja), es una duplicada y hay
# que borrarla, no re-trackearla.
/assets/
